---
// 客户端搜索组件，基于 Pagefind（构建后自动索引）
---

<div id="search" class="relative">
  <input
    id="search-input"
    type="search"
    placeholder="搜索文档、工具、资讯、题库…"
    autocomplete="off"
    class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] px-4 py-2 pl-9 text-sm text-[var(--text-1)] outline-none transition placeholder:text-[var(--text-3)] focus:border-[var(--border-strong)] focus:bg-[var(--surface-2)]"
  />
  <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--text-3)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z"></path>
  </svg>
  <div id="search-results" class="absolute z-20 mt-2 w-full overflow-hidden rounded-lg border border-[var(--border)] bg-[var(--card)] text-[var(--text-1)] shadow-xl"></div>
</div>

<script>
  async function initSearch() {
    const input = document.getElementById('search-input');
    const results = document.getElementById('search-results');
    if (!input || !results) return;

    let pagefind = null;
    try {
      // 用 new Function 构造动态 import：Vite 无法静态分析其内部，
      // 从而不会用 __vitePreload 包装，也避免被 @vite-ignore 后残留未定义的
      // __VITE_PRELOAD__（否则运行时抛 ReferenceError，搜索会静默失效）。
      // pagefind 索引在 postbuild 生成，dev 环境静默降级。
      const loadPagefind = new Function('u', 'return import(u)');
      pagefind = await loadPagefind('/pagefind/pagefind.js');
    } catch {
      return; // 未构建索引（dev 环境）时静默
    }

    let debounce;
    input.addEventListener('input', async () => {
      clearTimeout(debounce);
      const q = input.value.trim();
      debounce = setTimeout(async () => {
        if (!q) {
          results.innerHTML = '';
          results.classList.add('hidden');
          return;
        }
        const search = await pagefind.search(q);
        if (!search || search.results.length === 0) {
          results.innerHTML = '<div class="px-4 py-3 text-sm text-slate-500">未找到相关结果</div>';
          results.classList.remove('hidden');
          return;
        }
        const items = await Promise.all(
          search.results.slice(0, 8).map(async (r) => ({ r, data: await r.data() }))
        );
        results.innerHTML = items.map(({ data }) => `
          <a href="${data.url}" class="block px-4 py-3 transition hover:bg-[var(--surface-2)]">
            <p class="text-sm font-medium text-[var(--text-1)]">${data.meta.title || '未命名'}</p>
            ${data.excerpt ? `<p class="mt-0.5 text-xs text-[var(--text-3)] line-clamp-1">${data.excerpt}</p>` : ''}
          </a>
        `).join('');
        results.classList.remove('hidden');
      }, 200);
    });

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#search')) {
        results.classList.add('hidden');
      }
    });
  }
  initSearch();
</script>
