---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const roadmapCount = (await getCollection('roadmaps')).length;

const links = [
  { href: '/', label: '首页' },
  { href: '/docs', label: '官方文档' },
  { href: '/tools', label: 'AI 工具' },
  { href: '/info', label: '最新资讯' },
  { href: '/faq', label: '面试题库' },
  { href: '/roadmap', label: '学习路线' },
];
---

<Layout title="页面不存在" description="您访问的页面不存在或已迁移">
  <section class="mx-auto max-w-2xl py-16 text-center sm:py-24">
    <p class="text-7xl font-bold tracking-tight text-[var(--accent-text)] sm:text-8xl">404</p>
    <h1 class="mt-6 text-2xl font-bold sm:text-3xl">页面不存在</h1>
    <p class="mt-3 text-[var(--text-2)]">
      您访问的页面可能已迁移、删除，或从未存在。试试从下方入口重新出发。
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      {links.map((l) => (
        <a href={l.href} class="btn-ghost">
          {l.label}
        </a>
      ))}
    </div>

    <div class="card mt-12 p-6 text-left">
      <p class="text-sm font-semibold text-[var(--text-1)]">不知道从哪开始？</p>
      <p class="mt-2 text-sm leading-relaxed text-[var(--text-2)]">
        试试从「学习路线」入手——按方向分 {roadmapCount} 条路径，每条带阶段任务与检验标准，拿到就能照着学。
      </p>
      <a href="/roadmap" class="mt-3 inline-flex text-sm font-medium text-[var(--accent-text)] transition hover:text-indigo-200">
        查看学习路线 →
      </a>
    </div>
  </section>
</Layout>
