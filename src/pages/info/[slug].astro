---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const info = await getCollection('info');
  return info.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, source, url, summary, category, date, tags } = entry.data;

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl">
    <a href="/info" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--text-2)] transition hover:text-[var(--accent-text)]">← 返回资讯</a>

    <div class="mt-4 flex items-center gap-2 text-xs">
      <span class="badge">{category}</span>
      <span class="text-[var(--text-3)]">{source}</span>
      <span class="text-[var(--text-3)]">·</span>
      <time class="text-[var(--text-3)]" datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <h1 class="mt-4 text-2xl font-bold leading-snug text-[var(--text-1)] sm:text-3xl">{title}</h1>

    <div class="card mt-6 p-6 sm:p-8">
      <p class="text-base leading-relaxed text-[var(--text-2)]">{summary}</p>
    </div>

    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="btn-primary mt-6"
    >
      阅读原文 ↗
    </a>

    {tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded-full bg-[var(--surface-2)] px-2.5 py-1 text-xs text-[var(--text-2)]">#{t}</span>)}
      </div>
    )}
  </article>
</Layout>
