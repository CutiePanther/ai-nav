---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const info = await getCollection('info');
  return info.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, source, url, summary, category, date, tags } = entry.data;

const categoryColor: Record<string, string> = {
  行业快讯: 'bg-indigo-50 text-indigo-600',
  技术前沿: 'bg-purple-50 text-purple-600',
  开源动态: 'bg-emerald-50 text-emerald-600',
  政策产业: 'bg-orange-50 text-orange-600',
};

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl">
    <a href="/info" class="text-sm text-gray-500 hover:text-indigo-600">← 返回资讯</a>

    <div class="mt-4 flex items-center gap-2 text-xs">
      <span class={`rounded px-2 py-0.5 ${categoryColor[category] ?? 'bg-gray-100 text-gray-600'}`}>
        {category}
      </span>
      <span class="text-gray-400">{source}</span>
      <span class="text-gray-400">·</span>
      <time class="text-gray-400" datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <h1 class="mt-3 text-2xl font-bold leading-snug sm:text-3xl">{title}</h1>

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{t}</span>)}
      </div>
    )}

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6">
      <p class="text-base leading-relaxed text-gray-700">{summary}</p>
    </div>

    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="mt-6 inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-indigo-700"
    >
      阅读原文 ↗
    </a>
  </article>
</Layout>
