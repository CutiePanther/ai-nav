---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const faq = await getCollection('faq');

const categories = [...new Set(faq.map((f) => f.data.category))];
const grouped = categories.map((cat) => ({
  cat,
  items: faq.filter((f) => f.data.category === cat),
}));

const diffColor: Record<string, string> = {
  入门: 'bg-green-50 text-green-700',
  进阶: 'bg-amber-50 text-amber-700',
  高级: 'bg-red-50 text-red-600',
};
---

<Layout title="精选面试题" description="大模型、机器学习、深度学习、工程系统的高频面试题精选集">
  <h1 class="text-2xl font-bold">精选面试题</h1>
  <p class="mt-2 text-gray-500">
    精选集起步：高频题 + 原创要点 + 参考外链（LeetCode / 牛客 / CodeTop），暂不自建判题。
  </p>

  {grouped.map(({ cat, items }) => (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-indigo-600">{cat}</h2>
      <div class="space-y-4">
        {items.map((q) => (
          <div class="rounded-xl border border-gray-200 bg-white p-5">
            <div class="flex items-start gap-3">
              <span class={`mt-0.5 shrink-0 rounded px-2 py-0.5 text-xs ${diffColor[q.data.difficulty] ?? 'bg-gray-100 text-gray-600'}`}>
                {q.data.difficulty}
              </span>
              <a href={`/faq/${q.id}/`} class="font-semibold leading-snug hover:text-indigo-600">{q.data.title}</a>
            </div>
            <div class="mt-3 rounded-lg bg-gray-50 p-4 text-sm leading-relaxed text-gray-700">
              {q.data.answer}
            </div>
            {q.data.refs.length > 0 && (
              <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
                <span class="text-gray-400">参考：</span>
                {q.data.refs.map((r) => (
                  <a href={r.url} target="_blank" rel="noopener" class="text-indigo-600 hover:underline">
                    {r.label} ↗
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </section>
  ))}
</Layout>
