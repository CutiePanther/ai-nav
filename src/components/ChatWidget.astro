---
// AI 聊天组件：接入 ai-service 的 /api/chat SSE 流式接口
// 事件流：sources（引用来源）→ delta（逐字正文）→ done
// 两种形态：
//   mode="floating"  悬浮球 + 弹窗面板（全站注入到 Layout）
//   mode="inline"    内嵌面板（/ai 独立页，撑满父容器）
// 交互：AI 消息左侧品牌头像 + 全宽流式、推荐问题卡片化、打字三圆点、
//      发送按钮可中断生成、AI 消息 hover 复制、头部新对话按钮
// 输出：marked（GFM）+ DOMPurify（XSS 净化）+ [ref:N] 徽标
//
// 注：style 用 is:global + .chat-widget 前缀，因为 JS 注入的 DOM（消息、空态）
//     没有 Astro 的 data-astro-cid 属性，scoped CSS 无法匹配。global + 前缀
//     让所有选择器能跨模板/动态 DOM 匹配，同时不污染其他组件。
import { getCollection } from 'astro:content';

interface Props {
  mode?: 'floating' | 'inline';
}
const { mode = 'floating' } = Astro.props;
const faqCount = (await getCollection('faq')).length;
const roadmapCount = (await getCollection('roadmaps')).length;
---

<div id="chat-root" class="chat-widget" data-mode={mode} data-faq-count={faqCount} data-roadmap-count={roadmapCount}>
  {mode === 'floating' && (
    <button id="chat-fab" class="chat-fab" type="button" aria-label="打开 AI 助手">
      <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26" aria-hidden="true">
        <path d="M12 1.5c0 5.5 1.5 7 6.5 7-5 0-6.5 1.5-6.5 7 0-5.5-1.5-7-6.5-7 5 0 6.5-1.5 6.5-7z" />
        <circle cx="19" cy="19" r="1.4" opacity="0.55" />
        <circle cx="5" cy="6" r="1.1" opacity="0.4" />
      </svg>
    </button>
  )}

  <div id="chat-panel" class="chat-panel">
    <!-- 头部：品牌头像 + 标题/副标题 + 操作按钮 -->
    <header class="chat-head">
      <div class="chat-head-brand">
        <span class="ai-avatar ai-avatar-md" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 1.5c0 5.5 1.5 7 6.5 7-5 0-6.5 1.5-6.5 7 0-5.5-1.5-7-6.5-7 5 0 6.5-1.5 6.5-7z" />
            <circle cx="19" cy="19" r="1.4" opacity="0.55" />
            <circle cx="5" cy="6" r="1.1" opacity="0.4" />
          </svg>
        </span>
        <div class="chat-head-info">
          <div class="chat-head-title">AI 学习助手</div>
          <div class="chat-head-sub">站内 114 题 · 5 条学习路线</div>
        </div>
      </div>
      <div class="chat-head-actions">
        <button id="chat-new" class="chat-icon-btn" type="button" aria-label="新对话" title="新对话">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </button>
        {mode === 'floating' && (
          <button id="chat-close" class="chat-icon-btn" type="button" aria-label="关闭（Esc）" title="关闭（Esc）">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        )}
      </div>
    </header>

    <!-- 消息列表 -->
    <div id="chat-messages" class="chat-messages" role="log" aria-live="polite"></div>

    <!-- 输入区：textarea + 发送/停止按钮 -->
    <div class="chat-inputbar">
      <textarea
        id="chat-input"
        rows="1"
        placeholder="向 AI 助手提问…（Enter 发送 · Shift+Enter 换行）"
        class="chat-textarea"
        aria-label="提问输入"
      ></textarea>
      <button id="chat-send" class="chat-send-btn" type="button" aria-label="发送">
        <svg class="icon-send" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/></svg>
        <svg class="icon-stop" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  // AI 服务地址：构建时可经 PUBLIC_AI_API_BASE  覆盖
  const API_BASE = (import.meta.env.PUBLIC_AI_API_BASE || 'http://localhost:8787').replace(/\/$/, '');

  // 站外链接新窗口打开（一次性配置）
  DOMPurify.addHook('afterSanitizeAttributes', (node) => {
    if (node.tagName === 'A' && /^https?:\/\//.test(node.getAttribute('href') || '')) {
      node.setAttribute('target', '_blank');
      node.setAttribute('rel', 'noopener noreferrer');
    }
  });

  // ---------- 共享 SVG 资源 ----------
  // 头像 SVG：靠 CSS .ai-avatar svg { width:62%; height:62% } 控制尺寸，无需 inline style
  const AI_AVATAR_SVG = '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5c0 5.5 1.5 7 6.5 7-5 0-6.5 1.5-6.5 7 0-5.5-1.5-7-6.5-7 5 0 6.5-1.5 6.5-7z"/><circle cx="19" cy="19" r="1.4" opacity="0.55"/><circle cx="5" cy="6" r="1.1" opacity="0.4"/></svg>';
  const COPY_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
  const CHECK_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" width="12" height="12"><path d="M20 6 9 17l-5-5"/></svg>';

  // ---------- 元素引用 ----------
  const root = document.getElementById('chat-root');
  const mode = root.dataset.mode;
  const messagesEl = document.getElementById('chat-messages');
  const inputEl = document.getElementById('chat-input');
  const sendBtn = document.getElementById('chat-send');
  const newBtn = document.getElementById('chat-new');

  let busy = false;
  let currentStream = null;

  // ---------- 工具 ----------
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight;
  }
  function setBusy(v) {
    busy = v;
    inputEl.disabled = v;
    if (v) {
      sendBtn.classList.add('is-stop');
      sendBtn.setAttribute('aria-label', '停止生成');
    } else {
      sendBtn.classList.remove('is-stop');
      sendBtn.setAttribute('aria-label', '发送');
      currentStream = null;
    }
  }
  function renderMarkdown(text, sources) {
    let html = DOMPurify.sanitize(marked.parse(text));
    html = html.replace(/\[ref:(\d+)\]/g, (m, n) => {
      const src = sources[Number(n) - 1];
      if (!src) return `[${n}]`;
      return `<a href="${src.url}" class="ref-badge" title="${escapeHtml(src.title)}">[${n}]</a>`;
    });
    return html;
  }

  // ---------- 添加消息 ----------
  function addMessage(role, content) {
    const wrap = document.createElement('div');
    wrap.className = `msg msg-${role}`;
    let bubble;
    if (role === 'ai') {
      const av = document.createElement('span');
      av.className = 'ai-avatar ai-avatar-sm';
      av.innerHTML = AI_AVATAR_SVG;
      wrap.appendChild(av);
      const ctn = document.createElement('div');
      ctn.className = 'msg-content';
      bubble = document.createElement('div');
      bubble.className = 'msg-bubble';
      bubble.innerHTML = content;
      ctn.appendChild(bubble);
      wrap.appendChild(ctn);
    } else {
      bubble = document.createElement('div');
      bubble.className = 'msg-bubble';
      bubble.textContent = content;
      wrap.appendChild(bubble);
    }
    messagesEl.appendChild(wrap);
    scrollToBottom();
    return { wrap, bubble };
  }

  // 流式完成后给 AI 消息加复制按钮
  function attachCopyButton(ub, answer) {
    const contentEl = ub.querySelector('.msg-content');
    if (!contentEl) return;
    const copyBtn = document.createElement('button');
    copyBtn.className = 'msg-copy';
    copyBtn.type = 'button';
    copyBtn.innerHTML = COPY_SVG;
    copyBtn.title = '复制 Markdown 原文';
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(answer);
        copyBtn.innerHTML = CHECK_SVG;
        copyBtn.classList.add('is-copied');
        setTimeout(() => {
          copyBtn.innerHTML = COPY_SVG;
          copyBtn.classList.remove('is-copied');
        }, 1500);
      } catch {}
    });
    contentEl.appendChild(copyBtn);
  }

  // ---------- 空态：卡片化推荐 ----------
  function renderEmpty() {
    messagesEl.innerHTML = `
      <div class="chat-empty">
        <div class="chat-empty-head">
          <span class="ai-avatar ai-avatar-lg">${AI_AVATAR_SVG}</span>
          <p class="chat-empty-title">你好，我是 AI 学习助手</p>
          <p class="chat-empty-desc">基于站内 ${faqCount} 道面试题与 ${roadmapCount} 条学习路线，每个结论都带引用可点击跳转原文。</p>
        </div>
        <div class="chat-suggest-grid">
          <button class="chat-suggest-card" data-q="什么是 RAG？它解决了什么问题？">
            <span class="chat-suggest-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 10v6M4.22 4.22l4.24 4.24m7.08 7.08l4.24 4.24M1 12h6m10 0h6M4.22 19.78l4.24-4.24m7.08-7.08l4.24-4.24"/></svg>
            </span>
            <span class="chat-suggest-title">什么是 RAG？</span>
            <span class="chat-suggest-desc">检索增强生成的原理与适用场景</span>
          </button>
          <button class="chat-suggest-card" data-q="LoRA 微调的原理和优势是什么？">
            <span class="chat-suggest-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M12 2L9 9l-7 1 5 5-1 7 6-3 6 3-1-7 5-5-7-1z"/></svg>
            </span>
            <span class="chat-suggest-title">LoRA 微调原理</span>
            <span class="chat-suggest-desc">低秩适配如何省显存提效果</span>
          </button>
          <button class="chat-suggest-card" data-q="怎么从零开始学大模型？">
            <span class="chat-suggest-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            </span>
            <span class="chat-suggest-title">怎么学大模型</span>
            <span class="chat-suggest-desc">从入门到进阶的完整学习路径</span>
          </button>
          <button class="chat-suggest-card" data-q="Transformer 的注意力机制是怎样计算的？">
            <span class="chat-suggest-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><circle cx="6" cy="6" r="3"/><circle cx="18" cy="18" r="3"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M8.5 7.5l7 9M15.5 7.5l-7 9"/></svg>
            </span>
            <span class="chat-suggest-title">Attention 机制</span>
            <span class="chat-suggest-desc">Q/K/V 与多头注意力的核心计算</span>
          </button>
        </div>
      </div>`;
    messagesEl.querySelectorAll('[data-q]').forEach((b) => {
      b.addEventListener('click', () => {
        inputEl.value = b.getAttribute('data-q');
        send();
      });
    });
  }

  // ---------- 发送 / 停止 ----------
  async function send() {
    if (busy) {
      if (currentStream) {
        try { currentStream.cancel(); } catch {}
        currentStream = null;
        setBusy(false);
      }
      return;
    }
    const question = inputEl.value.trim();
    if (!question) return;
    inputEl.value = '';
    inputEl.style.height = 'auto';
    setBusy(true);

    addMessage('user', question);
    const { wrap, bubble } = addMessage('ai', '<span class="chat-typing"><span></span><span></span><span></span></span>');

    let sources = [];
    let answer = '';
    let hasSources = false;

    try {
      const res = await fetch(`${API_BASE}/api/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ question }),
      });
      if (!res.ok || !res.body) throw new Error(`服务返回 ${res.status}`);

      currentStream = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      let event = 'message';

      while (true) {
        const { done, value } = await currentStream.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop() ?? '';
        for (const line of lines) {
          const t = line.trim();
          if (!t) continue;
          if (t.startsWith('event:')) {
            event = t.slice(6).trim();
          } else if (t.startsWith('data:')) {
            const payload = t.slice(5).trim();
            if (event === 'sources') {
              try { sources = (JSON.parse(payload).sources) || []; hasSources = true; } catch {}
            } else if (event === 'delta') {
              if (payload === '[DONE]') continue;
              try {
                const c = JSON.parse(payload).choices?.[0]?.delta?.content;
                if (c) {
                  answer += c;
                  bubble.innerHTML = `<div class="answer-text">${escapeHtml(answer)}</div>`;
                  scrollToBottom();
                }
              } catch {}
            } else if (event === 'error') {
              throw new Error(payload);
            }
          }
        }
      }

      // 流结束：渲染完整 Markdown
      let html = '';
      if (!answer) {
        html = `<div class="answer-text">（无返回内容）</div>`;
      } else {
        html = `<div class="answer-text">${renderMarkdown(answer, sources)}</div>`;
        if (hasSources && sources.length > 0) {
          html += `<div class="sources"><p class="sources-title">参考来源</p><ul>`;
          sources.forEach((s, i) => {
            html += `<li><a href="${s.url}"><span class="src-idx">${i + 1}</span><span class="src-body"><span class="src-title">${escapeHtml(s.title)}</span><span class="src-cat">${escapeHtml(s.category)}</span></span></a></li>`;
          });
          html += `</ul></div>`;
        }
      }
      bubble.innerHTML = html;
      attachCopyButton(wrap, answer);
      scrollToBottom();
    } catch (err) {
      const msg = err && err.message ? err.message : String(err);
      bubble.innerHTML = `<div class="answer-text chat-error">⚠️ ${escapeHtml(msg)}。请确认 AI 服务已启动（<code>cd ai-service && npm run dev</code>）。</div>`;
    } finally {
      setBusy(false);
      inputEl.focus();
    }
  }

  // ---------- 事件绑定 ----------
  sendBtn.addEventListener('click', send);
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  });
  inputEl.addEventListener('input', () => {
    inputEl.style.height = 'auto';
    inputEl.style.height = Math.min(inputEl.scrollHeight, 160) + 'px';
  });
  newBtn?.addEventListener('click', () => {
    if (busy && currentStream) {
      try { currentStream.cancel(); } catch {}
    }
    setBusy(false);
    currentStream = null;
    inputEl.value = '';
    renderEmpty();
    inputEl.focus();
  });

  if (mode === 'floating') {
    const fab = document.getElementById('chat-fab');
    const closeBtn = document.getElementById('chat-close');
    fab?.addEventListener('click', () => { root.classList.add('is-open'); inputEl.focus(); });
    closeBtn?.addEventListener('click', () => root.classList.remove('is-open'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        root.classList.remove('is-open');
      }
    });
  }

  renderEmpty();
</script>

<style is:global>
  /* is:global + .chat-widget 前缀：Astro scoped CSS 对 JS 注入的 DOM（消息、空态）
     失效（注入元素无 data-astro-cid）。global 让所有选择器无 cid 匹配，
     .chat-widget 前缀限定作用域不污染其他组件。 */

  /* ============ 根容器 ============ */
  .chat-widget { display: flex; flex-direction: column; }
  .chat-widget[data-mode='floating'] {
    position: fixed; right: 24px; bottom: 24px; z-index: 50;
    align-items: flex-end; gap: 16px;
  }
  .chat-widget[data-mode='inline'] { /* no border/bg */ }

  /* ============ 悬浮球 ============ */
  .chat-widget .chat-fab {
    width: 56px; height: 56px;
    border-radius: 50%; border: none; cursor: pointer;
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: white;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 10px 28px -6px rgba(99, 102, 241, 0.7);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .chat-widget .chat-fab:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 14px 34px -6px rgba(99, 102, 241, 0.85);
  }

  /* ============ 面板 ============ */
  .chat-widget .chat-panel {
    display: flex; flex-direction: column;
    border-radius: 18px;
    border: 1px solid rgba(148, 163, 184, 0.16);
    background: rgba(13, 21, 38, 0.95);
    backdrop-filter: blur(16px);
    box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  /* inline 撑满父容器，固定高度让 messages 滚动 */
  .chat-widget[data-mode='inline'] .chat-panel {
    width: 100%;
    height: min(78vh, 720px);
  }
  /* floating 固定宽度 */
  .chat-widget[data-mode='floating'] .chat-panel {
    width: 440px;
    height: min(78vh, 640px);
    opacity: 0;
    transform: translateY(16px) scale(0.96);
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
  }
  .chat-widget[data-mode='floating'].is-open .chat-panel {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    visibility: visible;
  }

  /* ============ 头部 ============ */
  .chat-widget .chat-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 14px;
    border-bottom: 1px solid rgba(148, 163, 184, 0.12);
    background: linear-gradient(180deg, rgba(99, 102, 241, 0.08), rgba(99, 102, 241, 0.02));
  }
  .chat-widget .chat-head-brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .chat-widget .chat-head-info { min-width: 0; }
  .chat-widget .chat-head-title { font-size: 0.95rem; font-weight: 600; color: #e6edf6; line-height: 1.3; }
  .chat-widget .chat-head-sub { font-size: 11px; color: #7c8db5; line-height: 1.3; margin-top: 1px; }
  .chat-widget .chat-head-actions { display: flex; align-items: center; gap: 2px; }
  .chat-widget .chat-icon-btn {
    width: 30px; height: 30px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 8px; border: none; background: transparent;
    color: #a3b1c6; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .chat-widget .chat-icon-btn:hover { background: rgba(148, 163, 184, 0.14); color: #e6edf6; }

  /* ============ AI 头像系统 ============ */
  .chat-widget .ai-avatar {
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 50%; flex-shrink: 0;
    background: linear-gradient(135deg, #22d3ee, #6366f1);
    color: white;
    box-shadow: 0 4px 12px -2px rgba(99, 102, 241, 0.4);
    overflow: hidden;
  }
  .chat-widget .ai-avatar svg {
    display: block;
    width: 62%;
    height: 62%;
  }
  .chat-widget .ai-avatar-sm { width: 28px; height: 28px; }
  .chat-widget .ai-avatar-md { width: 36px; height: 36px; }
  .chat-widget .ai-avatar-lg { width: 56px; height: 56px; }

  /* ============ 消息区 ============ */
  .chat-widget .chat-messages {
    flex: 1; overflow-y: auto;
    padding: 20px 18px 12px;
    display: flex; flex-direction: column; gap: 18px;
    scroll-behavior: smooth;
  }
  .chat-widget .chat-messages::-webkit-scrollbar { width: 6px; }
  .chat-widget .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-widget .chat-messages::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.2); border-radius: 3px;
  }
  .chat-widget .chat-messages::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.35);
  }

  .chat-widget .msg { display: flex; gap: 10px; align-items: flex-start; }
  .chat-widget .msg-user { justify-content: flex-end; }
  .chat-widget .msg-ai .msg-content {
    position: relative; flex: 1; min-width: 0;
    display: flex; flex-direction: column;
  }
  .chat-widget .msg-bubble {
    font-size: 0.925rem; line-height: 1.7; word-break: break-word;
    border-radius: 14px; padding: 10px 14px;
  }
  .chat-widget .msg-user .msg-bubble {
    background: linear-gradient(135deg, #22d3ee, #6366f1);
