---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const faq = await getCollection('faq');
  return faq.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, difficulty, answer, refs, tags } = entry.data;

const diffColor: Record<string, string> = {
  入门: 'bg-green-50 text-green-700',
  进阶: 'bg-amber-50 text-amber-700',
  高级: 'bg-red-50 text-red-600',
};

const catColor: Record<string, string> = {
  大模型: 'bg-indigo-50 text-indigo-600',
  机器学习: 'bg-purple-50 text-purple-600',
  深度学习: 'bg-emerald-50 text-emerald-600',
  工程系统: 'bg-orange-50 text-orange-600',
};
---

<Layout title={title} description={answer.slice(0, 120)}>
  <article class="mx-auto max-w-3xl">
    <a href="/faq" class="text-sm text-gray-500 hover:text-indigo-600">← 返回题库</a>

    <div class="mt-4 flex items-center gap-2 text-xs">
      <span class={`rounded px-2 py-0.5 ${catColor[category] ?? 'bg-gray-100 text-gray-600'}`}>
        {category}
      </span>
      <span class={`rounded px-2 py-0.5 ${diffColor[difficulty] ?? 'bg-gray-100 text-gray-600'}`}>
        {difficulty}
      </span>
    </div>

    <h1 class="mt-3 text-2xl font-bold leading-snug sm:text-3xl">{title}</h1>

    <div class="mt-6 rounded-xl border border-gray-200 bg-white p-6">
      <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-400">要点解答</h2>
      <div class="text-base leading-relaxed text-gray-700">{answer}</div>
    </div>

    {refs.length > 0 && (
      <div class="mt-6">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-gray-400">参考链接</h2>
        <div class="flex flex-wrap gap-2">
          {refs.map((r) => (
            <a
              href={r.url}
              target="_blank"
              rel="noopener"
              class="rounded-lg bg-indigo-50 px-3 py-2 text-sm text-indigo-700 transition hover:bg-indigo-100"
            >
              {r.label} ↗
            </a>
          ))}
        </div>
      </div>
    )}

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{t}</span>)}
      </div>
    )}
  </article>
</Layout>
