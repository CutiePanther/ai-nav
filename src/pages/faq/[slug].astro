---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const faq = await getCollection('faq');
  return faq.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, difficulty, answer, refs, tags } = entry.data;

const diffColor: Record<string, string> = {
  入门: 'text-emerald-400',
  进阶: 'text-amber-400',
  高级: 'text-rose-400',
};
---

<Layout title={title} description={answer}>
  <article class="mx-auto max-w-3xl">
    <a href="/faq" class="font-mono text-xs tracking-[0.12em] text-[var(--text-2)] transition hover:text-[var(--hal-text)]">← 返回题库</a>

    <div class="mt-4 flex items-center gap-2 text-xs">
      <span class="badge">{category}</span>
      <span class={`font-mono text-xs ${diffColor[difficulty] ?? 'text-[var(--text-3)]'}`}>
        {difficulty}
      </span>
    </div>

    <h1 class="font-display mt-4 text-2xl font-medium leading-snug tracking-[0.08em] text-[var(--text-1)] sm:text-3xl">{title}</h1>

    <div class="mt-4 rounded-sm border border-[var(--border)] bg-[var(--surface-2)] px-4 py-3 text-sm leading-relaxed text-[var(--text-2)]">
      <span class="font-semibold text-[var(--hal-text)]">一句话要点：</span>{answer}
    </div>

    <div class="card mt-6 p-6 sm:p-8">
      <div class="section-head mb-4">
        <span class="section-index">01</span>
        <h2 class="section-title text-sm uppercase tracking-[0.14em] text-[var(--text-2)]">详细解答</h2>
      </div>
      <div class="prose-answer text-[var(--text-2)]">
        <Content />
      </div>
    </div>

    {refs.length > 0 && (
      <div class="mt-6">
        <div class="section-head mb-3">
          <span class="section-index">02</span>
          <h2 class="section-title text-sm uppercase tracking-[0.14em] text-[var(--text-2)]">参考链接</h2>
        </div>
        <div class="flex flex-wrap gap-2">
          {refs.map((r) => (
            <a
              href={r.url}
              target="_blank"
              rel="noopener"
              class="rounded-sm border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm font-medium text-[var(--hal-text)] transition hover:border-[var(--border-strong)] hover:bg-[var(--surface-2)]"
            >
              {r.label} ↗
            </a>
          ))}
        </div>
      </div>
    )}

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="badge">#{t}</span>)}
      </div>
    )}
  </article>
</Layout>
