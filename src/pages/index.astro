---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const docs = await getCollection('docs');
const tools = await getCollection('tools');
const info = (await getCollection('info'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);
const faq = await getCollection('faq');
const roadmaps = await getCollection('roadmaps');

// Hero 装饰：内容统计
const heroStats = [
  { n: docs.length, l: '文档' },
  { n: tools.length, l: '工具' },
  { n: faq.length, l: '题目' },
  { n: roadmaps.length, l: '路线' },
];

// AI 问答仅本地/内网可用：本地开发(DEV)始终显示；生产构建需显式设 PUBLIC_AI_ENABLED=true（如内网部署）。
// 公开平台（如 Vercel）不设该变量，则自动隐藏 AI 入口，避免访客请求自己机器的 localhost 而报错。
const AI_VISIBLE = import.meta.env.DEV || import.meta.env.PUBLIC_AI_ENABLED === 'true';
---

<Layout title="首页" description="AI 开发者的一站式学习导航站：聚合文档、工具、资讯、题库与学习路线，从入门到进阶的完整路径">
  <!-- ============ Hero：渐变标语 + AI 搜索 + 统计装饰 ============ -->
  <section class="hero-panel relative pb-12 pt-16 sm:pt-20">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-3xl font-bold leading-tight tracking-tight sm:text-4xl">
        从入门到进阶的<br class="sm:hidden" /><span class="text-grad-accent">AI 开发学习路径</span>
      </h1>
      {AI_VISIBLE && (
        <p class="mx-auto mt-4 max-w-xl text-base text-[var(--text-2)]">
          不确定从哪入手？问 AI 助手，基于站内题库与学习路线作答，每个结论都带引用、可跳转原文。
        </p>
      )}
    </div>

    <!-- 单一 AI 搜索框：提交后跳转 AI 详情页（仅本地/内网可用） -->
    {AI_VISIBLE && (
      <form action="/ai" method="get" class="mx-auto mt-7 flex w-full max-w-2xl items-center rounded-xl border border-[var(--border)] bg-[var(--surface)] p-1.5 transition focus-within:border-[var(--accent)]">
        <div class="flex flex-1 items-center gap-2 pl-3 pr-2">
          <Icon name="lucide:search" class="h-4 w-4 shrink-0 text-[var(--text-3)]" />
          <input
            name="q"
            type="text"
            placeholder="搜索 AI 开发问题，例如：什么是 RAG？"
            autocomplete="off"
            aria-label="搜索 AI 开发问题"
            class="home-search-input w-full flex-1 bg-transparent py-2.5 text-sm text-[var(--text-1)] outline-none placeholder:text-[var(--text-3)]"
          />
        </div>
        <button type="submit" class="btn-primary shrink-0 rounded-lg px-5">搜索</button>
      </form>
    )}

    <!-- Hero 装饰：内容统计 -->
    <div class="mx-auto mt-10 grid max-w-2xl grid-cols-2 gap-3 sm:grid-cols-4">
      {heroStats.map((s) => (
        <div class="card px-4 py-3 text-center">
          <p class="text-2xl font-bold tabular-nums text-[var(--text-1)]">{s.n}</p>
          <p class="mt-0.5 text-xs tracking-wide text-[var(--text-3)]">{s.l}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 如何使用本站 ============ -->
  <section class="mt-16">
    <h2 class="section-title text-2xl">如何使用本站</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {[
        { title: '查文档 · 找工具', desc: '需要什么就搜什么，官方文档与 AI 工具按分类聚合，点开即用。' },
        { title: '追资讯 · 学知识', desc: '每天看看最新行业动态与技术前沿，保持信息不落后。' },
        { title: '刷题库 · 跟路线', desc: '对照学习路线图按阶段推进，用面试题检验掌握程度。' },
      ].map((s) => (
        <div class="card p-6">
          <h3 class="text-lg font-semibold tracking-tight text-[var(--text-1)]">{s.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-2)]">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ 最新资讯 ============ -->
  <section class="mt-16">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="section-title text-2xl">最新资讯</h2>
      <a href="/info" class="text-sm font-medium text-[var(--accent-text)] transition hover:text-indigo-200">查看全部 →</a>
    </div>
    <div class="card overflow-hidden p-0">
      {info.map((item, i) => (
        <a
          href={`/info/${item.id}/`}
          class:list={['flex items-start gap-3 px-5 py-4 transition hover:bg-white/[0.03]', i !== 0 && 'border-t border-[var(--border)]']}
        >
          <span class="badge mt-0.5 shrink-0">{item.data.category}</span>
          <div class="min-w-0">
            <p class="font-medium leading-snug text-[var(--text-1)]">{item.data.title}</p>
            <p class="mt-1 text-sm text-[var(--text-3)]">{item.data.source} · {item.data.date.toLocaleDateString('zh-CN')}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>