---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');

const catIcon: Record<string, string> = {
  '大模型 API': 'cpu',
  '框架': 'blocks',
  '推理部署': 'server',
  '向量库': 'database',
  '应用层': 'layout-grid',
};

const categories = [...new Set(docs.map((d) => d.data.category))];
const grouped = categories.map((cat) => ({
  cat,
  items: docs.filter((d) => d.data.category === cat),
}));

const zhColor: Record<string, string> = {
  中文: 'text-emerald-400',
  英文: 'text-amber-400',
  中英: 'text-[var(--hal-text)]',
};

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<Layout title="官方文档" description="大模型 API、框架、推理部署、向量库、应用层的官方文档导航库">
  <header class="mb-8">
    <h1 class="font-display text-3xl font-medium tracking-[0.08em] sm:text-4xl">官方文档导航库</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-2)]">
      聚合 AI 开发常用官方文档，附一句话简介、中文友好度与常用度标签，点击直达官网。
    </p>
  </header>

  {grouped.map(({ cat, items }, idx) => (
    <section class="mt-10">
      <div class="section-head mb-4">
        <span class="section-index">{String(idx + 1).padStart(2, '0')}</span>
        <h2 class="section-title flex items-center gap-2 text-lg text-[var(--text-1)]">
          <Icon name={catIcon[cat] ?? 'book'} size={20} />
          {cat}
        </h2>
        <span class="badge">{items.length}</span>
      </div>
      <div class="grid gap-3 sm:grid-cols-2">
        {items.map((doc) => (
          <a
            href={doc.data.url}
            target="_blank"
            rel="noopener"
            class="card card-lift group flex flex-col p-5"
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-display font-medium leading-snug tracking-[0.04em] text-[var(--text-1)] transition group-hover:text-[var(--hal-text)]">{doc.data.title}</h3>
              <span class={`shrink-0 text-xs font-medium ${zhColor[doc.data.zhLevel] ?? 'text-[var(--text-3)]'}`}>
                {doc.data.zhLevel}
              </span>
            </div>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-2)]">{doc.data.description}</p>
            <div class="mt-3 flex items-center justify-between text-xs text-[var(--text-3)]">
              <span class="text-amber-300" title={`常用度 ${doc.data.popularity}/5`}>{stars(doc.data.popularity)}</span>
              {doc.data.tags.length > 0 && (
                <span class="flex flex-wrap justify-end gap-1">
                  {doc.data.tags.slice(0, 3).map((t) => <span class="badge">{t}</span>)}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>
