---
import Layout from '../../layouts/Layout.astro';
import { roadmaps } from '../../data/roadmaps';

export function getStaticPaths() {
  return roadmaps.map((r) => ({ params: { slug: r.slug }, props: { roadmap: r } }));
}

const { roadmap } = Astro.props;
const all = roadmaps;
---

<Layout title={roadmap.title} description={roadmap.target}>
  <div class="mb-6 flex items-center justify-between">
    <a href="/roadmap" class="text-sm text-gray-500 hover:text-indigo-600">← 返回路线图</a>
    <div class="flex items-center gap-2 text-sm">
      {all.map((r) => (
        <a
          href={`/roadmap/${r.slug}`}
          class:list={[
            'rounded-full px-3 py-1 transition',
            r.slug === roadmap.slug
              ? 'bg-indigo-600 text-white'
              : 'bg-gray-100 text-gray-600 hover:bg-gray-200',
          ]}
        >
          {r.title}
        </a>
      ))}
    </div>
  </div>

  <header class="mb-8 text-center">
    <div class="text-4xl">{roadmap.icon}</div>
    <h1 class="mt-3 text-3xl font-bold">{roadmap.title}</h1>
    <p class="mt-2 text-gray-500">{roadmap.target}</p>
    <p class="mt-1 text-sm text-indigo-600">预计 {roadmap.duration}</p>
  </header>

  <div class="relative mx-auto max-w-2xl">
    <!-- 时间轴竖线 -->
    <div class="absolute left-5 top-0 bottom-0 w-px bg-indigo-100"></div>

    <div class="space-y-8">
      {roadmap.stages.map((stage, i) => (
        <div class="relative flex gap-4">
          <!-- 节点圆点 -->
          <div class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white ring-4 ring-white">
            {i + 1}
          </div>
          <div class="flex-1 rounded-xl border border-gray-200 bg-white p-5">
            <h2 class="font-semibold text-gray-900">{stage.name}</h2>
            <p class="mt-1 text-sm text-gray-500">{stage.desc}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {stage.resources.map((res) => (
                <a
                  href={res.url}
                  target="_blank"
                  rel="noopener"
                  class="rounded-lg bg-indigo-50 px-3 py-1.5 text-sm text-indigo-700 transition hover:bg-indigo-100"
                >
                  {res.label} ↗
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
