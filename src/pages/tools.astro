---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

const catMeta: Record<string, { icon: string; desc: string }> = {
  AI编程: { icon: 'code', desc: 'AI 代码编辑器与编程助手' },
  AI开发平台: { icon: 'blocks', desc: 'LLM 应用与智能体开发平台' },
  AI智能体: { icon: 'bot', desc: '自主执行任务的 AI Agent' },
  AI聊天: { icon: 'messages-square', desc: '对话式大模型助手' },
  AI大模型: { icon: 'cpu', desc: '模型社区与本地部署' },
  AI学习平台: { icon: 'graduation-cap', desc: '竞赛、课程与免费算力' },
  AI写作: { icon: 'pen-line', desc: '写作润色与内容生成' },
  AI图像: { icon: 'image', desc: '文生图与图像创作' },
  AI视频: { icon: 'video', desc: '文生视频与视频创作' },
  AI办公: { icon: 'briefcase', desc: '办公协同与文档智能' },
  AI音频: { icon: 'music', desc: '语音合成与音频处理' },
  AI搜索引擎: { icon: 'search', desc: 'AI 原生搜索与问答' },
};

const categories = Object.keys(catMeta);
const freeColor: Record<string, string> = {
  免费: 'text-emerald-400',
  付费: 'text-rose-400',
  免费增值: 'text-amber-400',
};

const ACTIVE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--accent)] px-3.5 py-1.5 text-sm font-medium text-white transition';
const IDLE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--surface)] px-3.5 py-1.5 text-sm text-[var(--text-2)] ring-1 ring-[var(--border)] transition hover:text-[var(--accent-text)] hover:ring-[var(--border-strong)]';
---

<Layout title="AI 工具大全" description="按分类导航 AI 写作、图像、视频、编程、开发平台、智能体等常用 AI 工具">
  <header class="mb-6">
    <h1 class="text-3xl font-bold sm:text-4xl">AI 工具大全</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-2)]">
      精选 {tools.length} 个常用 AI 工具，支持搜索、分类筛选与排序，点击卡片直达官网。
    </p>
  </header>

  <!-- 搜索 + 排序 -->
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="relative flex-1">
      <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-3)]">
        <Icon name="search" size={18} />
      </span>
      <input
        id="tool-search"
        type="text"
        placeholder="搜索工具名称、描述或标签…"
        class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] py-2.5 pl-10 pr-4 text-sm text-[var(--text-1)] placeholder:text-[var(--text-3)] outline-none transition focus:border-indigo-400/50 focus:bg-[var(--surface-2)]"
      />
    </div>
    <select
      id="tool-sort"
      class="shrink-0 cursor-pointer rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--text-2)] outline-none transition focus:border-[var(--ring)]"
    >
      <option value="default" class="bg-[var(--background)] text-[var(--text-1)]">默认排序</option>
      <option value="free" class="bg-[var(--background)] text-[var(--text-1)]">免费优先</option>
      <option value="name" class="bg-[var(--background)] text-[var(--text-1)]">名称 A-Z</option>
    </select>
  </div>

  <!-- 分类筛选 -->
  <div class="sticky top-16 z-20 -mx-4 mb-6 bg-[var(--background)]/85 px-4 py-3 backdrop-blur-md sm:top-[68px]">
    <div class="flex flex-wrap gap-2" id="filter-bar">
      <button data-filter="all" class={ACTIVE}>全部</button>
      {categories.map((c) => (
        <button data-filter={c} class={IDLE}>
          <Icon name={catMeta[c].icon} size={14} />{c}
        </button>
      ))}
    </div>
  </div>

  <!-- 工具网格 -->
  <div id="tool-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <a
        href={t.data.url}
        target="_blank"
        rel="noopener"
        data-category={t.data.category}
        data-free={t.data.free}
        data-title={t.data.title}
        data-search={(t.data.title + ' ' + t.data.description + ' ' + t.data.category + ' ' + t.data.tags.join(' ')).toLowerCase()}
        class="tool-card card card-lift group flex flex-col p-5"
      >
        <div class="flex items-start justify-between gap-2">
          <h2 class="font-semibold leading-snug text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">{t.data.title}</h2>
          <span class={`shrink-0 text-xs font-medium ${freeColor[t.data.free] ?? 'text-[var(--text-3)]'}`}>
            {t.data.free}
          </span>
        </div>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-2)]">{t.data.description}</p>
        <div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs text-[var(--text-3)]">
          <span class="badge"><Icon name={catMeta[t.data.category]?.icon} size={12} />{t.data.category}</span>
          {t.data.tags.slice(0, 3).map((tag) => (
            <span class="rounded bg-[var(--surface-2)] px-1.5 py-0.5">{tag}</span>
          ))}
        </div>
      </a>
    ))}
  </div>

  <!-- 空状态 -->
  <div id="tool-empty" class="card mt-8 hidden p-12 text-center">
    <p class="text-[var(--text-2)]">没有匹配的工具，试试换个关键词或分类。</p>
  </div>
</Layout>

<script>
  const chips = document.querySelectorAll('.filter-chip');
  const cards = Array.from(document.querySelectorAll('.tool-card'));
  const grid = document.getElementById('tool-grid');
  const empty = document.getElementById('tool-empty');
  const searchInput = document.getElementById('tool-search');
  const sortSelect = document.getElementById('tool-sort');
  const ACTIVE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--accent)] px-3.5 py-1.5 text-sm font-medium text-white transition';
  const IDLE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--surface)] px-3.5 py-1.5 text-sm text-[var(--text-2)] ring-1 ring-[var(--border)] transition hover:text-[var(--accent-text)] hover:ring-[var(--border-strong)]';

  let activeCat = 'all';

  function apply() {
    const q = searchInput.value.trim().toLowerCase();
    const visible = [];
    cards.forEach((card) => {
      const matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      const matchQ = !q || card.dataset.search.includes(q);
      const show = matchCat && matchQ;
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    });

    // 排序
    const order = sortSelect.value;
    if (order === 'free') {
      const rank = { '免费': 0, '免费增值': 1, '付费': 2 };
      visible.sort((a, b) => rank[a.dataset.free] - rank[b.dataset.free]);
    } else if (order === 'name') {
      visible.sort((a, b) => a.dataset.title.localeCompare(b.dataset.title, 'zh'));
    }

    // 按新顺序重挂载
    visible.forEach((card) => grid.appendChild(card));
    empty.classList.toggle('hidden', visible.length > 0);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.filter;
      chips.forEach((c) => { c.className = c.dataset.filter === activeCat ? ACTIVE : IDLE; });
      apply();
    });
  });

  searchInput.addEventListener('input', apply);
  sortSelect.addEventListener('change', apply);
</script>
