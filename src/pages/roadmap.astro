---
import Layout from '../layouts/Layout.astro';
import { roadmaps } from '../data/roadmaps';
---

<Layout title="学习路线图" description="按方向分路线的大模型应用、算法研究、AI 工程化、多模态学习路线图">
  <h1 class="text-2xl font-bold">学习路线图</h1>
  <p class="mt-2 text-gray-500">
    按方向规划「筑基 → 核心 → 实战 → 前沿」的进阶路线，每条路线附带分阶段配套资源。
  </p>

  <div class="mt-8 grid gap-4 sm:grid-cols-2">
    {roadmaps.map((r) => (
      <a
        href={`/roadmap/${r.slug}`}
        class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow"
      >
        <div class="flex items-center gap-3">
          <span class="text-3xl">{r.icon}</span>
          <h2 class="text-lg font-semibold group-hover:text-indigo-600">{r.title}</h2>
        </div>
        <p class="mt-3 text-sm text-gray-500">{r.target}</p>
        <div class="mt-4 flex items-center justify-between">
          <span class="text-sm text-indigo-600">{r.duration}</span>
          <span class="text-xs text-gray-400">{r.stages.length} 个阶段 →</span>
        </div>
        <!-- 阶段预览 -->
        <div class="mt-4 flex flex-wrap gap-1.5">
          {r.stages.map((s) => (
            <span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{s.name}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</Layout>
