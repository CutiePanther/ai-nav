---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const faq = await getCollection('faq');
  return faq.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, difficulty, answer, refs, tags } = entry.data;

// 少数 FAQ 在解答前嵌入概念信息图（与主题强相关的少数页面）
const heroImage = entry.id === 'attention-mechanism'
  ? { src: '/infographics/attention.png', alt: '注意力机制：词与词互相看，Q 提问 / K 匹配 / V 内容，相关性越高看得越用力' }
  : entry.id === 'what-is-rag'
  ? { src: '/infographics/rag.png', alt: 'RAG 检索增强生成：让 AI 开卷考试' }
  : entry.id === 'what-is-agent'
  ? { src: '/infographics/agent.png', alt: 'AI Agent：会自己干活的循环' }
  : null;

const diffColor: Record<string, string> = {
  入门: 'text-emerald-400',
  进阶: 'text-amber-400',
  高级: 'text-rose-400',
};
---

<Layout title={title} description={answer}>
  <article class="mx-auto max-w-3xl">
    <a href="/faq" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--text-2)] transition hover:text-[var(--accent-text)]">← 返回题库</a>

    <div class="mt-4 flex items-center gap-2 text-xs">
      <span class="badge">{category}</span>
      <span class={`font-medium ${diffColor[difficulty] ?? 'text-[var(--text-3)]'}`}>
        {difficulty}
      </span>
    </div>

    <h1 class="mt-4 text-2xl font-bold leading-snug text-[var(--text-1)] sm:text-3xl">{title}</h1>

    <div class="mt-4 rounded-xl border border-[var(--border)] bg-[var(--surface-2)] px-4 py-3 text-sm leading-relaxed text-[var(--text-2)]">
      <span class="font-semibold text-[var(--accent-text)]">一句话要点：</span>{answer}
    </div>

    {heroImage && (
      <figure class="info-figure mt-6">
        <img src={heroImage.src} alt={heroImage.alt} width="1536" height="1024" loading="lazy" />
      </figure>
    )}

    <div class="card mt-6 p-6 sm:p-8">
      <h2 class="mb-4 flex items-center gap-2 text-sm font-bold uppercase tracking-wide text-[var(--text-3)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>详细解答
      </h2>
      <div class="prose-answer text-[var(--text-2)]">
        <Content />
      </div>
    </div>

    {refs.length > 0 && (
      <div class="mt-6">
        <h2 class="mb-3 text-sm font-bold uppercase tracking-wide text-[var(--text-3)]">参考链接</h2>
        <div class="flex flex-wrap gap-2">
          {refs.map((r) => (
            <a
              href={r.url}
              target="_blank"
              rel="noopener"
              class="rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-2 text-sm font-medium text-[var(--accent-text)] transition hover:border-[var(--border-strong)] hover:bg-[var(--surface-2)]"
            >
              {r.label} ↗
            </a>
          ))}
        </div>
      </div>
    )}

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded-full bg-[var(--surface-2)] px-2.5 py-1 text-xs text-[var(--text-2)]">#{t}</span>)}
      </div>
    )}
  </article>
</Layout>
