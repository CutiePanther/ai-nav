---
import Layout from '../layouts/Layout.astro';
import ChatWidget from '../components/ChatWidget.astro';

// AI 问答：本地(DEV)始终显示；生产需提供 AI 服务地址 PUBLIC_AI_API_BASE（如已部署的 Worker）
// 或显式设 PUBLIC_AI_ENABLED=true。未配置时页面展示「暂未开放」优雅降级，避免请求死地址。
const AI_VISIBLE =
  import.meta.env.DEV ||
  import.meta.env.PUBLIC_AI_ENABLED === 'true' ||
  Boolean(import.meta.env.PUBLIC_AI_API_BASE);
---

<Layout title="AI 助手" description="基于站内题库与学习路线的 AI 学习助手，带引用回答你的 AI 开发学习问题" floatingAI={false}>
  {AI_VISIBLE ? (
    <div class="mx-auto max-w-3xl pt-6">
      <ChatWidget mode="inline" />
    </div>
  ) : (
    <div class="mx-auto max-w-3xl pt-24 pb-16 text-center">
      <p class="text-lg font-semibold text-[var(--text-1)]">AI 助手暂未开放</p>
      <p class="mt-2 text-sm text-[var(--text-2)]">该功能仅在本地/内网环境可用，敬请期待公开版本。</p>
    </div>
  )}
</Layout>