---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { roadmaps } from '../data/roadmaps';

const docs = await getCollection('docs');
const info = (await getCollection('info'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 5);
const faq = await getCollection('faq');

// 文档按分类统计
const docCategories = [...new Set(docs.map((d) => d.data.category))];
const infoCategories = [...new Set(info.map((i) => i.data.category))];
---

<Layout title="首页" description="AI 开发者的学习导航 + 内容聚合 + 精选题库 + 学习路线一站式入口">
  <section class="mb-10 text-center">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      追资讯 · 查文档 · 刷题库 · 跟路线
    </h1>
    <p class="mt-3 text-gray-500">
      AI 开发者的一站式学习导航站，聚合散落各处的优质资源，结构清晰、可检索。
    </p>
  </section>

  <!-- 四大栏目入口 -->
  <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <a href="/docs" class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow">
      <div class="text-2xl">📚</div>
      <h2 class="mt-3 text-lg font-semibold group-hover:text-indigo-600">官方文档</h2>
      <p class="mt-1 text-sm text-gray-500">大模型 API · 框架 · 推理部署 · 向量库导航库</p>
      <p class="mt-3 text-sm text-indigo-600">{docs.length} 个文档条目 · {docCategories.length} 个分类</p>
    </a>
    <a href="/info" class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow">
      <div class="text-2xl">📰</div>
      <h2 class="mt-3 text-lg font-semibold group-hover:text-indigo-600">最新资讯</h2>
      <p class="mt-1 text-sm text-gray-500">行业快讯 · 技术前沿 · 开源动态 · 政策产业</p>
      <p class="mt-3 text-sm text-indigo-600">聚合外链 + 摘要，持续更新</p>
    </a>
    <a href="/faq" class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow">
      <div class="text-2xl">🧠</div>
      <h2 class="mt-3 text-lg font-semibold group-hover:text-indigo-600">精选面试题</h2>
      <p class="mt-1 text-sm text-gray-500">大模型 · ML · DL · 工程高频题精选集</p>
      <p class="mt-3 text-sm text-indigo-600">{faq.length} 道精选题目</p>
    </a>
    <a href="/roadmap" class="group rounded-xl border border-gray-200 bg-white p-6 transition hover:border-indigo-300 hover:shadow">
      <div class="text-2xl">🗺️</div>
      <h2 class="mt-3 text-lg font-semibold group-hover:text-indigo-600">学习路线图</h2>
      <p class="mt-1 text-sm text-gray-500">应用开发 · 算法研究 · 工程化 · 多模态</p>
      <p class="mt-3 text-sm text-indigo-600">{roadmaps.length} 条路线 · 分阶段进阶</p>
    </a>
  </section>

  <!-- 最新资讯 -->
  <section class="mt-12">
    <div class="mb-4 flex items-center justify-between">
      <h2 class="text-xl font-semibold">最新资讯</h2>
      <a href="/info" class="text-sm text-indigo-600 hover:underline">查看全部 →</a>
    </div>
    <div class="divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white">
      {info.map((item) => (
        <a href={item.data.url} target="_blank" rel="noopener" class="flex items-start gap-3 px-5 py-4 transition hover:bg-gray-50">
          <span class="mt-1 shrink-0 rounded bg-indigo-50 px-2 py-0.5 text-xs text-indigo-600">{item.data.category}</span>
          <div>
            <p class="font-medium leading-snug hover:text-indigo-600">{item.data.title}</p>
            <p class="mt-1 text-sm text-gray-500">{item.data.source} · {item.data.date.toLocaleDateString('zh-CN')}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
