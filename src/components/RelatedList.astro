---
// 相关阅读：按「标签交集（权重 2）+ 分类一致（权重 1）」为当前条目打分，
// 取分值 > 0 的最高若干条，纯服务端计算、无 JS。
interface RelatedItem {
  id: string;
  title: string;
  link: string;
  category: string;
  tags: string[];
  meta?: string;
}
interface Props {
  items: RelatedItem[];
  current: { id: string; category: string; tags: string[] };
  max?: number;
  title?: string;
}
const { items, current, max = 4, title = '相关阅读' } = Astro.props;

const curTags = new Set(current.tags);
function score(it: RelatedItem) {
  let s = 0;
  it.tags.forEach((t) => {
    if (curTags.has(t)) s += 2;
  });
  if (it.category === current.category) s += 1;
  return s;
}

const related = items
  .filter((it) => it.id !== current.id)
  .map((it) => ({ it, s: score(it) }))
  .filter((x) => x.s > 0)
  .sort((a, b) => b.s - a.s || b.it.tags.length - a.it.tags.length)
  .slice(0, max)
  .map((x) => x.it);
---

{
  related.length > 0 && (
    <section class="mt-10">
      <h2 class="mb-3 text-lg font-bold text-[var(--text-1)]">{title}</h2>
      <div class="space-y-2">
        {related.map((r) => (
          <a href={r.link} class="group card card-lift block p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="truncate font-medium text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">{r.title}</p>
                {r.meta && <p class="mt-0.5 text-xs text-[var(--text-3)]">{r.meta}</p>}
              </div>
              <span class="badge shrink-0">{r.category}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )
}