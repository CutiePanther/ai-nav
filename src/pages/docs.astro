---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');

// 分组：按 category
const categories = [...new Set(docs.map((d) => d.data.category))];
const grouped = categories.map((cat) => ({
  cat,
  items: docs.filter((d) => d.data.category === cat),
}));

// 中文友好度标签配色
const zhColor: Record<string, string> = {
  中文: 'bg-green-50 text-green-700',
  英文: 'bg-amber-50 text-amber-700',
  中英: 'bg-sky-50 text-sky-700',
};

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}
---

<Layout title="官方文档" description="大模型 API、框架、推理部署、向量库、应用层的官方文档导航库">
  <h1 class="text-2xl font-bold">官方文档导航库</h1>
  <p class="mt-2 text-gray-500">聚合 AI 开发常用官方文档，附一句话简介、中文友好度与常用度标签。</p>

  {grouped.map(({ cat, items }) => (
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold text-indigo-600">{cat}</h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {items.map((doc) => (
          <a
            href={doc.data.url}
            target="_blank"
            rel="noopener"
            class="group rounded-xl border border-gray-200 bg-white p-5 transition hover:border-indigo-300 hover:shadow"
          >
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold group-hover:text-indigo-600">{doc.data.title}</h3>
              <span class={`shrink-0 rounded px-2 py-0.5 text-xs ${zhColor[doc.data.zhLevel] ?? 'bg-gray-100 text-gray-600'}`}>
                {doc.data.zhLevel}
              </span>
            </div>
            <p class="mt-2 text-sm text-gray-500">{doc.data.description}</p>
            <div class="mt-3 flex items-center justify-between text-xs text-gray-400">
              <span class="text-amber-500" title={`常用度 ${doc.data.popularity}/5`}>{stars(doc.data.popularity)}</span>
              {doc.data.tags.length > 0 && (
                <span class="flex gap-1">
                  {doc.data.tags.map((t) => <span class="rounded bg-gray-100 px-1.5 py-0.5">{t}</span>)}
                </span>
              )}
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</Layout>
