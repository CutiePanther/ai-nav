{
  "name": "ai-dev-nav",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-rss": "node scripts/fetch-rss.mjs",
    "prebuild": "node scripts/fetch-rss.mjs",
    "build": "astro build",
    "index": "pagefind --site dist",
    "postbuild": "pagefind --site dist && node scripts/gen-sitemap.mjs && node scripts/gen-rss.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.129",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "astro-icon": "^1.2.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "pagefind": "^1.5.2",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
