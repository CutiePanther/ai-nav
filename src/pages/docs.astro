---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');

const catIcon: Record<string, string> = {
  '大模型 API': 'cpu',
  '框架': 'blocks',
  '推理部署': 'server',
  '向量库': 'database',
  '应用层': 'layout-grid',
};

const categories = [...new Set(docs.map((d) => d.data.category))];
const grouped = categories.map((cat) => ({
  cat,
  items: docs.filter((d) => d.data.category === cat),
}));

const zhColor: Record<string, string> = {
  中文: 'text-emerald-400',
  英文: 'text-amber-400',
  中英: 'text-[var(--accent-text)]',
};

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(5 - n);
}

// 近 90 天更新则显示「更新」角标
const FRESH_MS = 90 * 24 * 3600e3;
const isFresh = (d?: Date) => !!d && Date.now() - new Date(d).getTime() <= FRESH_MS;

// 结构化数据：文档列表 ItemList（引擎收录用，样例前 30 条控制体积）
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI 官方文档导航库',
  itemListElement: docs.slice(0, 30).map((d, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: d.data.title,
    url: d.data.url,
  })),
};

// 投稿 / 纠错：一键跳到本站 GitHub Issues（预填条目名）
const ISSUE_BASE = 'https://github.com/CutiePanther/ai-nav/issues/new';
const issueUrl = (name: string) => `${ISSUE_BASE}?title=${encodeURIComponent(`数据纠错：${name}`)}`;
---
<Layout title="官方文档" description="大模型 API、框架、推理部署、向量库、应用层的官方文档导航库">
  <script is:inline type="application/ld+json">{itemList}</script>
  <header class="mb-8">
    <h1 class="text-3xl font-bold sm:text-4xl">官方文档导航库</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-2)]">
      聚合 AI 开发常用官方文档，附一句话简介、中文友好度与常用度标签，点击直达官网。
    </p>
  </header>

  {grouped.map(({ cat, items }) => (
    <section class="mt-10">
      <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-[var(--text-1)]">
        <Icon name={catIcon[cat] ?? 'book'} size={20} />
        {cat}
        <span class="badge">{items.length}</span>
      </h2>
      <div class="grid gap-3 sm:grid-cols-2">
        {items.map((doc) => (
          <div class="card card-lift group flex flex-col p-5">
            <div class="flex items-start justify-between gap-2">
              <a href={doc.data.url} target="_blank" rel="noopener" class="flex min-w-0 items-center gap-1.5 font-semibold leading-snug text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">
                <span class="truncate">{doc.data.title}</span>
                {isFresh(doc.data.updated) && (
                  <span class="shrink-0 rounded-full bg-[var(--accent)]/12 px-1.5 py-0.5 text-[10px] font-medium text-[var(--accent-text)]">更新</span>
                )}
              </a>
              <span class={`shrink-0 text-xs font-medium ${zhColor[doc.data.zhLevel] ?? 'text-[var(--text-3)]'}`}>
                {doc.data.zhLevel}
              </span>
            </div>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-2)]">{doc.data.description}</p>
            <div class="mt-3 flex items-center justify-between gap-2 text-xs text-[var(--text-3)]">
              <span class="text-amber-300" title={`常用度 ${doc.data.popularity}/5`}>{stars(doc.data.popularity)}</span>
              <span class="flex shrink-0 items-center gap-1">
                  {doc.data.tags.slice(0, 2).map((t) => <span class="rounded bg-[var(--surface-2)] px-1.5 py-0.5">{t}</span>)}
                  <FavoriteButton key={`doc|${doc.id}`} title={doc.data.title} url={doc.data.url} type="doc" class="!h-6 !w-6" />
                  <a href={issueUrl(doc.data.title)} target="_blank" rel="noopener" title="纠错 / 反馈" class="ml-1 font-medium text-[var(--accent-text)] transition hover:text-[var(--text-1)] hover:underline">纠错</a>
                </span>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}
</Layout>

<script>
  // 收藏功能（本地存储）
  import '../scripts/favorites.js';
</script>
