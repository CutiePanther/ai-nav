{
  "name": "ai-dev-nav",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "fetch-rss": "node scripts/fetch-rss.mjs",
    "import-guides": "node scripts/import-guides.mjs",
    "check": "astro check",
    "check:content": "astro sync",
    "check:types": "node scripts/check-types.mjs",
    "check:filenames": "node scripts/check-filenames.mjs",
    "check:index": "node scripts/check-index-freshness.mjs",
    "check:links": "node scripts/check-links.mjs",
    "verify": "npm run check:content && npm run check:types",
    "check:all": "npm run verify && npm run check:filenames && npm run check:index && npm run check:links",
    "prebuild": "node scripts/fetch-rss.mjs",
    "build": "astro build",
    "index": "pagefind --site dist",
    "postbuild": "pagefind --site dist && node scripts/gen-sitemap.mjs && node scripts/gen-rss.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@iconify-json/lucide": "^1.2.129",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "astro-icon": "^1.2.0",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.11",
    "pagefind": "^1.5.2",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.1",
    "typescript": "^6.0.3"
  }
}
