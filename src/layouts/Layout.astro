---
import '../styles/global.css';
import Search from '../components/Search.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  /** 是否注入全站悬浮球 AI 助手（默认 true；首页顶部已内嵌 AI 搜索面板时关掉，避免同名 id 冲突） */
  floatingAI?: boolean;
}

const { title, description, floatingAI = true } = Astro.props;
const siteName = 'AI 开发学习导航';
const canonical = new URL(Astro.url.pathname, Astro.site);
// 社交分享图：默认用首页「三步走」信息图
const ogImage = new URL('/infographics/home-guide.png', Astro.site);

// 悬浮 AI 助手：dev 始终显示；生产配置了 AI 服务地址（PUBLIC_AI_API_BASE）或 PUBLIC_AI_ENABLED=true 才注入。
// 未配置则隐藏悬浮球，避免访客请求不存在的服务而报错。
const AI_VISIBLE =
  import.meta.env.DEV ||
  import.meta.env.PUBLIC_AI_ENABLED === 'true' ||
  Boolean(import.meta.env.PUBLIC_AI_API_BASE);

const navLinks = [
  { href: '/docs', label: '文档' },
  { href: '/tools', label: '工具' },
  { href: '/info', label: '资讯' },
  { href: '/faq', label: '题库' },
  { href: '/roadmap', label: '路线图' },
  { href: '/favorites', label: '我的' },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-512.jpg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#000000" />
    <title>{title} · {siteName}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <!-- 社交分享 / OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={`${title} · ${siteName}`} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · ${siteName}`} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <!-- 站点级结构化数据：WebSite + 站内搜索 -->
    <script is:inline type="application/ld+json">
      {{
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: siteName,
        description,
        url: new URL('/', Astro.site),
        searchAction: {
          '@type': 'SearchAction',
          target: `${new URL('/ai', Astro.site)}?q={search_term_string}`,
          'query-input': 'required name=search_term_string',
        },
      }}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <!-- 防闪烁：渲染前根据 localStorage 设置亮暗主题（默认暗色） -->
    <script is:inline>
      (function () {
        var theme = localStorage.getItem("theme");
        if (theme !== "light" && theme !== "dark") {
          theme = "dark";
        }
        var html = document.documentElement;
        if (theme === "dark") html.classList.add("dark");
        else html.classList.remove("dark");
        html.style.colorScheme = theme;
        var tc = document.querySelector('meta[name="theme-color"]');
        if (tc) tc.setAttribute("content", theme === "dark" ? "#000000" : "#ffffff");
        window.__theme = theme;
      })();
    </script>

    <script>
      // PWA：生产环境注册离线 Service Worker（本地开发跳过，避免干扰 HMR）
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class="relative flex min-h-screen flex-col">
    <a href="#main" class="skip-link">跳到主内容</a>
    <header class="sticky top-0 z-30 border-b border-[var(--border)] bg-[var(--background)]/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex shrink-0 items-center gap-2 font-bold tracking-tight">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--accent)] text-sm font-bold text-white">AI</span>
          <span class="text-base sm:text-lg">开发学习导航</span>
        </a>
        <nav class="hidden shrink-0 items-center gap-1 text-sm font-medium text-[var(--text-2)] md:flex">
          {navLinks.map((l) => (
            <a
              href={l.href}
              class:list={[
                'relative rounded-full px-3 py-1.5 transition',
                (path === l.href || path.startsWith(l.href + '/'))
                  ? 'font-semibold text-[var(--text-1)]'
                  : 'hover:bg-[var(--surface-2)] hover:text-[var(--text-1)]',
              ]}
            >
              {l.label}
              {(path === l.href || path.startsWith(l.href + '/')) && (
                <span class="absolute inset-x-2 -bottom-px h-0.5 rounded-full bg-[var(--accent)]"></span>
              )}
            </a>
          ))}
        </nav>
        <div class="ml-auto flex w-full max-w-xs items-center gap-1.5">
          <div class="min-w-0 flex-1">
            <Search />
          </div>
          <button
            id="theme-toggle"
            type="button"
            aria-label="切换亮暗主题"
            title="切换亮暗主题"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[var(--text-2)] transition hover:bg-[var(--surface-2)] hover:text-[var(--text-1)]"
          >
            <!-- 亮色模式显示的月牙图标（点击切到暗色）；暗色模式显示太阳图标 -->
            <svg data-icon="moon" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
            <svg data-icon="sun" class="hidden h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          </button>
        </div>
      </div>
      <!-- 移动端导航 -->
      <nav class="flex items-center gap-1 overflow-x-auto px-4 pb-2 text-sm font-medium text-[var(--text-2)] md:hidden">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={[
              'shrink-0 rounded-full px-3 py-1 transition',
              (path === l.href || path.startsWith(l.href + '/'))
                ? 'bg-[var(--accent)] font-semibold text-white'
                : 'bg-[var(--surface-2)] hover:bg-[var(--border)]',
            ]}
          >
            {l.label}
          </a>
        ))}
      </nav>
    </header>

    <main id="main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-6 sm:py-10" data-pagefind-body>
      <slot />
    </main>

    <footer class="mt-8 border-t border-[var(--border)]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        {path === '/' && (
          <div class="flex flex-col gap-6 py-10 sm:flex-row sm:items-start sm:justify-between">
            <div class="max-w-sm">
              <div class="flex items-center gap-2 font-bold">
                <span class="flex h-7 w-7 items-center justify-center rounded-md bg-[var(--accent)] text-xs font-bold text-white">AI</span>
                <span>AI 开发学习导航</span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-[var(--text-2)]">
                追资讯 · 查文档 · 找工具 · 刷题库 · 跟路线，AI 开发者的一站式学习导航站。
              </p>
            </div>
            <div class="grid grid-cols-2 gap-8 text-sm sm:grid-cols-3">
              <div>
                <p class="font-semibold text-[var(--text-1)]">内容</p>
                <ul class="mt-3 space-y-2 text-[var(--text-2)]">
                  {navLinks.map((l) => (
                    <li><a href={l.href} class="transition hover:text-[var(--text-1)]">{l.label}</a></li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="font-semibold text-[var(--text-1)]">说明</p>
                <ul class="mt-3 space-y-2 text-[var(--text-2)]">
                  <li>聚合外链 + 精选内容</li>
                  <li>资讯构建期自动抓取</li>
                  <li>Git 版本化维护</li>
                  <li>
                    <a
                      href="https://github.com/CutiePanther/ai-nav/issues/new/choose"
                      target="_blank"
                      rel="noopener"
                      class="font-medium text-[var(--accent-text)] transition hover:underline"
                    >提交 / 纠错</a>
                  </li>
                </ul>
              </div>
              <div>
                <p class="font-semibold text-[var(--text-1)]">技术</p>
                <ul class="mt-3 space-y-2 text-[var(--text-2)]">
                  <li>Astro 7</li>
                  <li>Tailwind CSS v4</li>
                  <li>Pagefind 搜索</li>
                </ul>
              </div>
            </div>
          </div>
        )}
        <div class="border-t border-[var(--border)] py-6 text-center text-xs text-[var(--text-3)]">
          © {new Date().getFullYear()} AI 开发学习导航 · 内容版权归原作者所有，本站仅做聚合导航
        </div>
      </div>
    </footer>

    {AI_VISIBLE && floatingAI && <ChatWidget mode="floating" />}

    <script>
      const btn = document.getElementById('theme-toggle');
      if (btn) {
        const moon = btn.querySelector('[data-icon="moon"]');
        const sun = btn.querySelector('[data-icon="sun"]');
        function syncIcons(dark) {
          moon?.classList.toggle('hidden', dark);
          sun?.classList.toggle('hidden', !dark);
        }
        syncIcons(document.documentElement.classList.contains('dark'));
        btn.addEventListener('click', () => {
          const html = document.documentElement;
          const dark = html.classList.toggle('dark');
          html.style.colorScheme = dark ? 'dark' : 'light';
          localStorage.setItem('theme', dark ? 'dark' : 'light');
          syncIcons(dark);
          const tc = document.querySelector('meta[name="theme-color"]');
          if (tc) tc.setAttribute('content', dark ? '#000000' : '#ffffff');
        });
      }
    </script>
  </body>
</html>
