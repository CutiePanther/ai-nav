---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const info = await getCollection('info');
  return info.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, source, url, summary, category, date, tags } = entry.data;

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} description={summary}>
  <article class="mx-auto max-w-3xl">
    <a href="/info" class="font-mono text-xs tracking-[0.12em] text-[var(--text-2)] transition hover:text-[var(--hal-text)]">← 返回资讯</a>

    <div class="mt-4 flex items-center gap-2">
      <span class="badge">{category}</span>
      <span class="font-mono text-[11px] tracking-[0.06em] text-[var(--text-3)]">
        {source} ·
        <time datetime={date.toISOString()}>{formattedDate}</time>
      </span>
    </div>

    <h1 class="font-display mt-4 text-2xl font-medium leading-snug tracking-[0.08em] text-[var(--text-1)] sm:text-3xl">{title}</h1>

    <div class="card mt-6 p-6 sm:p-8">
      <p class="text-base leading-relaxed text-[var(--text-2)]">{summary}</p>
    </div>

    <a
      href={url}
      target="_blank"
      rel="noopener"
      class="btn-primary mt-6"
    >
      阅读原文 ↗
    </a>

    {tags.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="badge">#{t}</span>)}
      </div>
    )}
  </article>
</Layout>
