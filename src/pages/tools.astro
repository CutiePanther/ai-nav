---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import FavoriteButton from '../components/FavoriteButton.astro';
import { getCollection } from 'astro:content';

const tools = await getCollection('tools');

const catMeta: Record<string, { icon: string; desc: string }> = {
  AI编程: { icon: 'code', desc: 'AI 代码编辑器与编程助手' },
  AI开发平台: { icon: 'blocks', desc: 'LLM 应用与智能体开发平台' },
  AI智能体: { icon: 'bot', desc: '自主执行任务的 AI Agent' },
  AI聊天: { icon: 'messages-square', desc: '对话式大模型助手' },
  AI大模型: { icon: 'cpu', desc: '模型社区与本地部署' },
  AI学习平台: { icon: 'graduation-cap', desc: '竞赛、课程与免费算力' },
  AI写作: { icon: 'pen-line', desc: '写作润色与内容生成' },
  AI图像: { icon: 'image', desc: '文生图与图像创作' },
  AI视频: { icon: 'video', desc: '文生视频与视频创作' },
  AI办公: { icon: 'briefcase', desc: '办公协同与文档智能' },
  AI音频: { icon: 'music', desc: '语音合成与音频处理' },
  AI搜索引擎: { icon: 'search', desc: 'AI 原生搜索与问答' },
};

const categories = Object.keys(catMeta);
const freeColor: Record<string, string> = {
  免费: 'text-emerald-400',
  付费: 'text-rose-400',
  免费增值: 'text-amber-400',
};

const ACTIVE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--accent)] px-3.5 py-1.5 text-sm font-medium text-white transition';
const IDLE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--surface)] px-3.5 py-1.5 text-sm text-[var(--text-2)] ring-1 ring-[var(--border)] transition hover:text-[var(--accent-text)] hover:ring-[var(--border-strong)]';

// 近 90 天更新则显示「更新」角标
const FRESH_MS = 90 * 24 * 3600e3;
const isFresh = (d?: Date) => !!d && Date.now() - new Date(d).getTime() <= FRESH_MS;

// 结构化数据：工具列表 ItemList（引擎收录用，样例前 30 条控制体积）
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'AI 工具大全',
  itemListElement: tools.slice(0, 30).map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.data.title,
    description: t.data.description,
    url: t.data.url,
  })),
};

// 投稿 / 纠错：一键跳到本站 GitHub Issues（预填条目名）
const ISSUE_BASE = 'https://github.com/CutiePanther/ai-nav/issues/new';
const issueUrl = (name: string) => `${ISSUE_BASE}?title=${encodeURIComponent(`数据纠错：${name}`)}`;
---
<Layout title="AI 工具大全" description="按分类导航 AI 写作、图像、视频、编程、开发平台、智能体等常用 AI 工具">
  <script is:inline type="application/ld+json">{itemList}</script>
  <header class="mb-6">
    <h1 class="text-3xl font-bold sm:text-4xl">AI 工具大全</h1>
    <p class="mt-3 max-w-2xl text-[var(--text-2)]">
      精选 {tools.length} 个常用 AI 工具，支持搜索、分类筛选与排序，点击卡片直达官网。
    </p>
  </header>

  <!-- 搜索 + 排序 -->
  <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <div class="relative flex-1">
      <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-[var(--text-3)]">
        <Icon name="search" size={18} />
      </span>
      <input
        id="tool-search"
        type="text"
        placeholder="搜索工具名称、描述或标签…"
        class="w-full rounded-xl border border-[var(--border)] bg-[var(--surface)] py-2.5 pl-10 pr-4 text-sm text-[var(--text-1)] placeholder:text-[var(--text-3)] outline-none transition focus:border-indigo-400/50 focus:bg-[var(--surface-2)]"
      />
    </div>
    <select
      id="tool-sort"
      class="shrink-0 cursor-pointer rounded-xl border border-[var(--border)] bg-[var(--surface)] px-3.5 py-2.5 text-sm text-[var(--text-2)] outline-none transition focus:border-[var(--ring)]"
    >
      <option value="default" class="bg-[var(--background)] text-[var(--text-1)]">默认排序</option>
      <option value="hot" class="bg-[var(--background)] text-[var(--text-1)]">热度优先</option>
      <option value="free" class="bg-[var(--background)] text-[var(--text-1)]">免费优先</option>
      <option value="name" class="bg-[var(--background)] text-[var(--text-1)]">名称 A-Z</option>
    </select>
  </div>

  <!-- 分类筛选 -->
  <div class="sticky top-16 z-20 -mx-4 mb-6 bg-[var(--background)]/85 px-4 py-3 backdrop-blur-md sm:top-[68px]">
    <div class="flex flex-wrap gap-2" id="filter-bar">
      <button data-filter="all" class={ACTIVE}>全部</button>
      <button data-filter="__featured__" class={IDLE}>
        <Icon name="star" size={14} />精选
      </button>
      {categories.map((c) => (
        <button data-filter={c} class={IDLE}>
          <Icon name={catMeta[c].icon} size={14} />{c}
        </button>
      ))}
    </div>
  </div>

  <!-- 工具网格 -->
  <div id="tool-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <div
        data-category={t.data.category}
        data-free={t.data.free}
        data-title={t.data.title}
        data-featured={t.data.featured ? 'true' : 'false'}
        data-popularity={t.data.popularity}
        data-cmp-key={t.id}
        data-url={t.data.url}
        data-desc={t.data.description}
        data-tags={JSON.stringify(t.data.tags)}
        data-search={(t.data.title + ' ' + t.data.description + ' ' + t.data.category + ' ' + t.data.tags.join(' ')).toLowerCase()}
        class="tool-card card card-lift group flex flex-col p-5"
      >
        <div class="flex items-start justify-between gap-2">
          <a href={t.data.url} target="_blank" rel="noopener" class="flex min-w-0 items-center gap-1.5 font-semibold leading-snug text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">
            <span class="truncate">{t.data.title}</span>
            {t.data.featured && (
              <span class="shrink-0 rounded-full bg-[var(--accent)] px-1.5 py-0.5 text-[10px] font-medium text-white">精选</span>
            )}
            {isFresh(t.data.updated) && (
              <span class="shrink-0 rounded-full bg-[var(--accent)]/12 px-1.5 py-0.5 text-[10px] font-medium text-[var(--accent-text)]">更新</span>
            )}
          </a>
          <span class={`shrink-0 text-xs font-medium ${freeColor[t.data.free] ?? 'text-[var(--text-3)]'}`}>
            {t.data.free}
          </span>
        </div>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-2)]">{t.data.description}</p>
        <div class="mt-3 flex items-center justify-between gap-2 text-xs text-[var(--text-3)]">
          <span class="flex min-w-0 flex-wrap items-center gap-1.5">
            <span class="badge shrink-0"><Icon name={catMeta[t.data.category]?.icon} size={12} />{t.data.category}</span>
            {t.data.tags.slice(0, 3).map((tag) => (
              <span class="rounded bg-[var(--surface-2)] px-1.5 py-0.5">{tag}</span>
            ))}
          </span>
          <span class="flex shrink-0 items-center gap-2">
            <button
              data-cmp-key={t.id}
              type="button"
              aria-pressed="false"
              aria-label={`加入对比：${t.data.title}`}
              title="加入对比"
              class="cmp-toggle flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[var(--border)] text-[var(--text-3)] transition hover:border-[var(--accent-text)] hover:text-[var(--accent-text)]"
            >
              <span class="flex gap-[2px]" aria-hidden="true">
                <span class="h-3 w-1 rounded-sm bg-current"></span>
                <span class="h-3 w-1 rounded-sm bg-current"></span>
                <span class="h-3 w-1 rounded-sm bg-current"></span>
              </span>
            </button>
            <FavoriteButton key={`tool|${t.id}`} title={t.data.title} url={t.data.url} type="tool" />
            <a href={t.data.url} target="_blank" rel="noopener" class="font-medium text-[var(--accent-text)] hover:underline">访问 ↗</a>
            <a href={issueUrl(t.data.title)} target="_blank" rel="noopener" title="纠错 / 反馈" class="transition hover:text-[var(--text-1)] hover:underline">纠错</a>
          </span>
        </div>
      </div>
    ))}
  </div>

  <!-- 空状态 -->
  <div id="tool-empty" class="card mt-8 hidden p-12 text-center">
    <p class="text-[var(--text-2)]">没有匹配的工具，试试换个关键词或分类。</p>
  </div>

  <!-- 对比浮条 -->
  <div id="cmp-bar" class="fixed bottom-4 left-1/2 z-40 hidden -translate-x-1/2 items-center gap-3 rounded-full border border-[var(--border)] bg-[var(--card)] py-2 pl-4 pr-2 text-sm text-[var(--text-1)] shadow-2xl">
    <span id="cmp-count">已选 0 / 4</span>
    <button id="cmp-clear" type="button" class="rounded-full px-3 py-1.5 text-[var(--text-3)] transition hover:bg-[var(--surface-2)] hover:text-[var(--text-1)]">清空</button>
    <button id="cmp-run" type="button" disabled class="rounded-full bg-[var(--accent)] px-4 py-1.5 font-medium text-white opacity-50 transition enabled:opacity-100">开始对比</button>
  </div>

  <!-- 对比浮层 -->
  <div id="cmp-overlay" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-label="工具对比">
    <div class="card max-h-[85vh] w-full max-w-4xl overflow-auto p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h3 class="text-lg font-bold text-[var(--text-1)]">工具对比</h3>
        <button id="cmp-close" type="button" aria-label="关闭" class="flex h-8 w-8 items-center justify-center rounded-full text-[var(--text-2)] transition hover:bg-[var(--surface-2)] hover:text-[var(--text-1)]">✕</button>
      </div>
      <div id="cmp-table" class="overflow-x-auto"></div>
      <p id="cmp-hint" class="mt-4 text-center text-sm text-[var(--text-3)]">对比仅在当前页面会话内有效，最多同时对比 4 个工具。</p>
    </div>
  </div>
</Layout>

<script>
  const chips = document.querySelectorAll('.filter-chip');
  const cards = Array.from(document.querySelectorAll('.tool-card'));
  const grid = document.getElementById('tool-grid');
  const empty = document.getElementById('tool-empty');
  const searchInput = document.getElementById('tool-search');
  const sortSelect = document.getElementById('tool-sort');
  const ACTIVE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--accent)] px-3.5 py-1.5 text-sm font-medium text-white transition';
  const IDLE = 'filter-chip inline-flex items-center gap-1.5 whitespace-nowrap rounded-full bg-[var(--surface)] px-3.5 py-1.5 text-sm text-[var(--text-2)] ring-1 ring-[var(--border)] transition hover:text-[var(--accent-text)] hover:ring-[var(--border-strong)]';

  let activeCat = 'all';

  function apply() {
    const q = searchInput.value.trim().toLowerCase();
    const visible = [];
    cards.forEach((card) => {
      let matchCat;
      if (activeCat === '__featured__') matchCat = card.dataset.featured === 'true';
      else matchCat = activeCat === 'all' || card.dataset.category === activeCat;
      const matchQ = !q || card.dataset.search.includes(q);
      const show = matchCat && matchQ;
      card.style.display = show ? '' : 'none';
      if (show) visible.push(card);
    });

    // 排序
    const order = sortSelect.value;
    if (order === 'free') {
      const rank = { '免费': 0, '免费增值': 1, '付费': 2 };
      visible.sort((a, b) => rank[a.dataset.free] - rank[b.dataset.free]);
    } else if (order === 'hot') {
      visible.sort((a, b) => (Number(b.dataset.popularity) - Number(a.dataset.popularity)) || a.dataset.title.localeCompare(b.dataset.title, 'zh'));
    } else if (order === 'name') {
      visible.sort((a, b) => a.dataset.title.localeCompare(b.dataset.title, 'zh'));
    }

    // 按新顺序重挂载
    visible.forEach((card) => grid.appendChild(card));
    empty.classList.toggle('hidden', visible.length > 0);
  }

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCat = chip.dataset.filter;
      chips.forEach((c) => { c.className = c.dataset.filter === activeCat ? ACTIVE : IDLE; });
      apply();
    });
  });

  searchInput.addEventListener('input', apply);
  sortSelect.addEventListener('change', apply);
</script>

<script>
  // —— 工具对比（会话内选择，最多 4 个）——
  const MAX_CMP = 4;
  const bar = document.getElementById('cmp-bar');
  const countEl = document.getElementById('cmp-count');
  const runBtn = document.getElementById('cmp-run');
  const clearBtn = document.getElementById('cmp-clear');
  const overlay = document.getElementById('cmp-overlay');
  const table = document.getElementById('cmp-table');
  const closeBtn = document.getElementById('cmp-close');
  const cmpCards = Array.from(document.querySelectorAll('.tool-card'));
  const cardByKey = new Map(cmpCards.map((c) => [c.dataset.cmpKey, c]));
  const toggles = Array.from(document.querySelectorAll('.cmp-toggle'));
  const selected = new Set(); // 选中的 tool id

  function paintToggle(btn, on) {
    btn.classList.toggle('cmp-on', on);
    btn.classList.toggle('border-[var(--accent-text)]', on);
    btn.classList.toggle('text-[var(--accent-text)]', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    const card = cardByKey.get(btn.dataset.cmpKey);
    if (card) card.classList.toggle('ring-2', on);
  }

  function syncBar() {
    const n = selected.size;
    const show = n > 0;
    bar.classList.toggle('hidden', !show);
    bar.classList.toggle('flex', show);
    countEl.textContent = `已选 ${n} / ${MAX_CMP}`;
    runBtn.disabled = n < 2;
  }

  function buildTable() {
    const rows = [
      ['工具', (c) => `<a href="${c.dataset.url}" target="_blank" rel="noopener" class="font-bold text-[var(--accent-text)] hover:underline">${c.dataset.title}</a>`],
      ['分类', (c) => c.dataset.category],
      ['收费', (c) => c.dataset.free],
      ['精选', (c) => (c.dataset.featured === 'true' ? '✓' : '—')],
      ['标签', (c) => (JSON.parse(c.dataset.tags || '[]').map((t) => t).join('、') || '—')],
      ['简介', (c) => `<p class="text-sm leading-relaxed text-[var(--text-2)]">${c.dataset.desc}</p>`],
    ];
    let html = '<table class="w-full border-collapse text-left text-sm text-[var(--text-1)]">';
    html += '<thead><tr><th class="border-b border-[var(--border)] px-3 py-2 font-semibold">指标</th>';
    html += selectedKeys().map((k) => {
      const c = cardByKey.get(k)?.dataset;
      return `<th class="border-b border-[var(--border)] px-3 py-2 font-semibold">${c ? c.title : k}</th>`;
    }).join('');
    html += '</tr></thead>';
    html += '<tbody>';
    rows.forEach(([label, fn]) => {
      html += `<tr><td class="whitespace-nowrap border-b border-[var(--border)] px-3 py-2 font-medium text-[var(--text-3)]">${label}</td>`;
      selectedKeys().forEach((k) => {
        const c = cardByKey.get(k);
        html += `<td class="border-b border-[var(--border)] px-3 py-2">${c ? fn(c) : '—'}</td>`;
      });
      html += '</tr>';
    });
    html += '</tbody></table>';
    table.innerHTML = html;
  }

  function selectedKeys() {
    return Array.from(selected);
  }

  function openOverlay() {
    if (selected.size < 2) return;
    buildTable();
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
  }

  function closeOverlay() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
  }

  function clearAll() {
    selected.clear();
    toggles.forEach((b) => paintToggle(b, false));
    syncBar();
  }

  toggles.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const k = btn.dataset.cmpKey;
      if (selected.has(k)) {
        selected.delete(k);
        paintToggle(btn, false);
      } else {
        if (selected.size >= MAX_CMP) {
          countEl.textContent = `最多选 ${MAX_CMP} 个`;
          return;
        }
        selected.add(k);
        paintToggle(btn, true);
      }
      syncBar();
    });
  });

  runBtn.addEventListener('click', openOverlay);
  clearBtn.addEventListener('click', clearAll);
  closeBtn.addEventListener('click', closeOverlay);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeOverlay(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeOverlay(); });

  // 页面初始时若有滚动则隐藏浮条避免遮挡，保持简单——浮条常驻底部即可
</script>

<script>
  // 收藏功能（本地存储），依赖 src/scripts/favorites.js 的初始化
  import '../scripts/favorites.js';
</script>
