---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const roadmaps = await getCollection('roadmaps');
  return roadmaps.map((r) => ({ params: { slug: r.id }, props: { roadmap: r } }));
}

const { roadmap } = Astro.props;
const all = await getCollection('roadmaps');
const totalTasks = roadmap.data.stages.reduce((n, s) => n + s.tasks.length, 0);
const totalSkills = roadmap.data.stages.reduce((n, s) => n + s.skills.length, 0);

const kindColor: Record<string, string> = {
  course: 'text-emerald-400',
  repo: 'text-[var(--accent-text)]',
  doc: 'text-[var(--accent-text)]',
  practice: 'text-amber-400',
};
const kindLabel: Record<string, string> = {
  course: '课程',
  repo: '仓库',
  doc: '文档',
  practice: '练习',
};
---

<Layout title={roadmap.data.title} description={roadmap.data.target}>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
    <a href="/roadmap" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--text-2)] transition hover:text-[var(--accent-text)]">← 返回路线图</a>
    <div class="flex flex-wrap items-center gap-2 text-sm">
      {all.map((r) => (
        <a
          href={`/roadmap/${r.id}`}
          class:list={[
            'rounded-full px-3 py-1 transition',
            r.id === roadmap.id
              ? 'bg-[var(--accent)] font-medium text-white'
              : 'bg-[var(--surface)] text-[var(--text-2)] ring-1 ring-[var(--border)] hover:text-[var(--accent-text)] hover:ring-[var(--border-strong)]',
          ]}
        >
          {r.data.title}
        </a>
      ))}
    </div>
  </div>

  <!-- 头图：排版优先，无图标 -->
  <header class="relative mb-10 overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] px-6 py-12 text-center sm:py-16">
    <div class="relative z-10">
      <div class="mx-auto mb-4 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--surface-2)] px-3 py-1 text-xs text-[var(--text-2)]">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>
        {roadmap.data.duration} · {roadmap.data.stages.length} 个阶段
      </div>
      <h1 class="text-3xl font-bold text-[var(--text-1)] sm:text-4xl">{roadmap.data.title}</h1>
      <p class="mx-auto mt-3 max-w-xl text-[var(--text-2)]">{roadmap.data.target}</p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-2 text-xs text-[var(--text-2)]">
        <span class="rounded-full bg-[var(--surface-2)] px-3 py-1">{totalTasks} 个学习任务</span>
        <span class="rounded-full bg-[var(--surface-2)] px-3 py-1">{totalSkills} 项核心技能</span>
      </div>

      <!-- 阶段完成进度 -->
      <div class="relative z-10 mx-auto mt-5 max-w-md">
        <div class="flex items-center justify-between text-xs text-[var(--text-3)]">
          <span id="rm-progress-text">已完成 0 / {roadmap.data.stages.length} 阶段</span>
        </div>
        <div class="progress-track mt-1.5"><div id="rm-progress-bar" class="progress-fill" style="width:0%"></div></div>
      </div>
    </div>
  </header>

  <!-- 先修要求 -->
  {roadmap.data.prerequisites.length > 0 && (
    <div class="card mx-auto mb-10 max-w-2xl p-5">
      <h2 class="text-sm font-bold uppercase tracking-wide text-[var(--text-2)]">先修要求</h2>
      <ul class="mt-3 space-y-1.5">
        {roadmap.data.prerequisites.map((p) => (
          <li class="flex items-center gap-2 text-sm text-[var(--text-2)]">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--accent)]"></span>{p}
          </li>
        ))}
      </ul>
    </div>
  )}

  <div class="relative mx-auto max-w-2xl">
    <!-- 时间轴竖线 -->
    <div class="absolute bottom-0 left-[26px] top-0 w-0.5 bg-[var(--accent)] opacity-20"></div>

    <div class="space-y-8">
      {roadmap.data.stages.map((stage, i) => (
        <div class="roadmap-stage relative flex gap-5">
          <!-- 节点圆点 -->
          <div class="stage-node relative z-10 flex h-[52px] w-[52px] shrink-0 items-center justify-center rounded-2xl bg-[var(--accent)] text-lg font-bold text-white">
            {i + 1}
          </div>
          <div class="stage-card card flex-1 p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h2 class="stage-name font-bold text-[var(--text-1)]">{stage.name}</h2>
              <div class="flex items-center gap-2">
                <span class="badge"><Icon name="clock" size={12} />{stage.time}</span>
                <button data-stage-done data-roadmap={roadmap.id} data-stage-idx={i} type="button" class="stage-done-btn">标记完成</button>
              </div>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-2)]">{stage.desc}</p>

            <!-- 核心技能点 -->
            <div class="mt-4 flex flex-wrap gap-1.5">
              {stage.skills.map((sk) => (
                <span class="rounded-full bg-[var(--accent)]/15 px-2.5 py-1 text-xs font-medium text-[var(--accent-text)]">{sk}</span>
              ))}
            </div>

            <!-- 具体任务 -->
            <div class="mt-4 rounded-xl border border-[var(--border)] bg-[var(--surface)] p-4">
              <p class="flex items-center gap-1.5 text-xs font-bold uppercase tracking-wide text-[var(--text-3)]"><Icon name="check-circle" size={14} class="text-emerald-400" /> 具体任务</p>
              <ul class="mt-2.5 space-y-1.5">
                {stage.tasks.map((t) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed text-[var(--text-2)]">
                    <span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]"></span>{t}
                  </li>
                ))}
              </ul>
            </div>

            <!-- 检验标准 -->
            <div class="mt-3 flex items-start gap-2.5 rounded-xl border border-amber-500/20 bg-amber-500/[0.06] p-4">
              <Icon name="flag" size={16} class="mt-0.5 shrink-0 text-amber-300" />
              <div>
                <p class="text-xs font-bold uppercase tracking-wide text-amber-400">检验标准（通过才能进入下一阶段）</p>
                <p class="mt-1 text-sm leading-relaxed text-amber-100/90">{stage.checkpoint}</p>
              </div>
            </div>

            <!-- 实践项目 -->
            {stage.project && (
              <div class="mt-3 flex items-start gap-2.5 rounded-xl border border-emerald-500/20 bg-emerald-500/[0.06] p-4">
                <Icon name="hammer" size={16} class="mt-0.5 shrink-0 text-emerald-300" />
                <div>
                  <p class="text-xs font-bold uppercase tracking-wide text-emerald-400">实践项目</p>
                  <p class="mt-1 text-sm leading-relaxed text-emerald-100/90">{stage.project}</p>
                </div>
              </div>
            )}

            <!-- 资源 -->
            <div class="mt-4 flex flex-wrap gap-2">
              {stage.resources.map((res) => (
                <a
                  href={res.url}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--surface)] px-3 py-1.5 text-sm font-medium text-[var(--accent-text)] transition hover:border-[var(--border-strong)] hover:bg-[var(--surface-2)]"
                >
                  {res.label} ↗
                  {res.kind && <span class={`text-[10px] font-semibold ${kindColor[res.kind] ?? ''}`}>{kindLabel[res.kind]}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>

<script>
  import { initRoadmapDetail } from '../../scripts/progress.js';
  initRoadmapDetail(roadmap.id, roadmap.data.stages.length);
</script>
