# 复制为 .env 并填入真实值（.env 已被 gitignore，绝不提交）

# OpenAI 兼容接口（DeepSeek / 通义 / GLM / OpenAI 均可，换供应商只改这里）
# 替换为你的 LLM 网关地址（自托管/云 API 均可）
OPENAI_BASE_URL=http://your-llm-gateway:port/v1
OPENAI_API_KEY=
MODEL=your-model-name

# Embedding 配置（复用同一网关，走 /v1/embeddings）
# 注：bge-m3 在部分网关上别名路由不稳定，建议改用稳定可用的 embedding 模型
# EMBEDDING_BASE_URL / EMBEDDING_API_KEY 未设置时自动回退到 OPENAI_* 同名项
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_QUERY_PREFIX=

# 服务端口
PORT=8787

# 主站域名（CORS 白名单，逗号分隔）
# 注：localhost / 127.0.0.1 的任意端口在代码里自动放行（本地开发便利），
#     此处只需配置生产环境的真实域名
ALLOWED_ORIGIN=http://localhost:4322

# 限流：每分钟每 IP 请求数
RATE_LIMIT_PER_MIN=10
