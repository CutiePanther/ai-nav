---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  const sorted = guides.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : null,
      next: i < sorted.length - 1 ? sorted[i + 1] : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const { title, description, order, category, tags, updated } = entry.data;

// 阅读时长估算（中文约 400 字/分钟）
const minutes = Math.max(1, Math.round((entry.body?.length ?? 0) / 400));
---

<Layout title={title} description={description}>
  <article class="mx-auto max-w-3xl">
    <a href="/guides" class="inline-flex items-center gap-1 text-sm font-medium text-[var(--text-2)] transition hover:text-[var(--accent-text)]">← 返回教程</a>

    <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
      <span class="badge">{category}</span>
      <span class="text-[var(--text-3)]">第 {String(order).padStart(2, '0')} 篇</span>
      <span class="text-[var(--text-3)]">·</span>
      <span class="text-[var(--text-3)]">约 {minutes} 分钟</span>
      {updated && (
        <>
          <span class="text-[var(--text-3)]">·</span>
          <span class="text-[var(--text-3)]">更新于 {updated.toLocaleDateString('zh-CN')}</span>
        </>
      )}
    </div>

    <h1 class="mt-4 text-2xl font-bold leading-snug text-[var(--text-1)] sm:text-3xl">{title}</h1>
    <p class="mt-3 text-sm leading-relaxed text-[var(--text-2)]">{description}</p>

    <div class="card mt-6 p-6 sm:p-8">
      <div class="prose-answer text-[var(--text-2)]">
        <Content />
      </div>
    </div>

    {tags.length > 0 && (
      <div class="mt-6 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded-full bg-[var(--surface-2)] px-2.5 py-1 text-xs text-[var(--text-2)]">#{t}</span>)}
      </div>
    )}

    <!-- 上下篇导航 -->
    {(prev || next) && (
      <nav class="mt-8 grid gap-3 border-t border-[var(--border)] pt-6 sm:grid-cols-2">
        {prev ? (
          <a href={`/guides/${prev.id}/`} class="card card-lift group p-4">
            <span class="text-xs text-[var(--text-3)]">← 上一篇</span>
            <p class="mt-1.5 text-sm font-medium leading-snug text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">
              {prev.data.title}
            </p>
          </a>
        ) : (
          <span></span>
        )}
        {next && (
          <a href={`/guides/${next.id}/`} class="card card-lift group p-4 sm:text-right">
            <span class="text-xs text-[var(--text-3)]">下一篇 →</span>
            <p class="mt-1.5 text-sm font-medium leading-snug text-[var(--text-1)] transition group-hover:text-[var(--accent-text)]">
              {next.data.title}
            </p>
          </a>
        )}
      </nav>
    )}
  </article>
</Layout>
